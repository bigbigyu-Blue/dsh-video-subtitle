{
  "name": "dsh-video-subtitle",
  "version": "0.11.1",
  "description": "DeepSeek Harness tool plugin: fetch video subtitles into local .srt files through a fallback provider chain — Bilibili's official subtitle API with login + WBI signature, a bundled yt-dlp downloader for every other video site the downloader knows (its own subtitles first, then local ASR on the downloaded audio), local faster-whisper ASR, local SenseVoice ASR. Batch fetch, 分P expansion, sentence reassembly into a plain transcript.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/**/*.js",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bigbigyu-Blue/dsh-video-subtitle.git"
  },
  "bugs": {
    "url": "https://github.com/bigbigyu-Blue/dsh-video-subtitle/issues"
  },
  "homepage": "https://github.com/bigbigyu-Blue/dsh-video-subtitle#readme",
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "dsh": ">=0.1.7-rc.1",
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "subtitle",
    "transcript",
    "bilibili",
    "youtube",
    "yt-dlp",
    "cordis"
  ]
}
